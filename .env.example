# ─── Database ────────────────────────────────────────────────────────────────
# A PostgreSQL server:          DATABASE_URL=postgres://user:password@host:5432/dbname
# The built-in database folder: DATABASE_URL=file:/absolute/path/to/nexora-ops-data
# (unset locally → ./local-data; unset in production → ~/nexora-ops-data)
DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora

# Only for the test suite (npm test).
TEST_DATABASE_URL=postgres://nexora:nexora@localhost:5432/nexora_test

# ─── First start ─────────────────────────────────────────────────────────────
# Temporary password for seeded accounts — everyone must change it at first sign-in. Use a long, private one.
SEED_DEFAULT_PASSWORD=change-me-to-a-long-temporary-password
# SEED_DEMO=0                     # another company: start empty with one admin (see WHITE-LABEL.md)
# ADMIN_USERNAME=admin            # …its username
# ADMIN_NAME=Admin                # …its display name
# SEED_FORCE_PASSWORD_CHANGE=0    # tests only — never in production

# ─── Server ──────────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=3000
# INSECURE_COOKIES=1              # ONLY for plain-http use on a local network (npm run local sets it)
